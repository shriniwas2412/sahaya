{
  "name": "sahaya-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"src/**/*.test.ts\" \"eval/*.test.ts\"",
    "voice:lines": "node scripts/export-demo-lines.ts",
    "eval": "node eval/run.ts",
    "qr": "node scripts/qr.mjs"
  },
  "engines": {
    "node": ">=23.6"
  },
  "dependencies": {
    "idb": "8.0.4",
    "preact": "10.29.8"
  },
  "devDependencies": {
    "@preact/preset-vite": "2.10.6",
    "@types/node": "24.19.2",
    "qrcode": "1.5.4",
    "typescript": "5.9.3",
    "vite": "7.3.7"
  }
}
